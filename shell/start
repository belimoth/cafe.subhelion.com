#!/bin/bash

set -o errexit

MSYS_NO_PATHCONV=1 subst /d a: | true && subst a: .

history -c
export HISTFILE=/a/null/.bash_history

export PATH=/a/shell:$PATH
[[ -z $USER ]] || export PATH=/a/shell/user/$USER:$PATH

# git fetch && git-check && git merge --ff-only && git push || true

code /a --reuse-window
