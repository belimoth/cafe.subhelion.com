#!/bin/bash

resize_one() {
	name=$( echo $1 | sed "s|/a/null/data/media||" )
	echo $name
	mkdir --parents $( dirname /a/code/static/image/media/$name )
	magick /a/null/data/media/$name -resize 160x240 -background black -gravity center -extent 160x240 /a/code/static/image/media/$name
}

export -f resize_one

find /a/null/data -name "*.jpg" -exec bash -c 'resize_one {}' \;
