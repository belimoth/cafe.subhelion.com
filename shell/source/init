publish() {
	/a/shell/build

	set -o noglob

	aws --profile subhelion.com s3 rm s3://cafe.subhelion.com --recursive

	aws --profile subhelion.com s3 sync /a/null/build/0 s3://cafe.subhelion.com --exclude * --include *.*
	aws --profile subhelion.com s3 sync /a/null/build/0 s3://cafe.subhelion.com --content-type text/html --exclude *.*
