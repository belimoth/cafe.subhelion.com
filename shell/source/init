install() {
	[[ $( uname --operating-system ) == "Msys"                            ]] || { echo "error: unsupported os";         exit 1; }
	[[ -x $( command -v python )                                          ]] || { echo "error: python not installed";   exit 1; }
	[[ $( python -c "import sys; print( sys.version_info[0] )" ) == "3"   ]] || { echo "error: python 3 not installed"; exit 1; }
	[[ $( python --version ) == $( cat /a/runtime.txt )                   ]] || { echo "warning: python version mismatch"; }

	python -m venv /a/null/venv
	source /a/shell/source/activate
	python -m pip install --upgrade pip
	pip install --requirement /a/shell/python/requirements.txt
}

freeze() {
	source /a/shell/source/activate
	python --version > /a/shell/python/runtime.txt
	pip freeze       > /a/shell/python/requirements.txt
}

